{
    "semi": false,
    "singleQuote": true,
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",

    "bracketSameLine": false,
    "htmlWhitespaceSensitivity": "ignore",
    "singleAttributePerLine": true,
    "plugins": ["prettier-plugin-tailwindcss"]
}
