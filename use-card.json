{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "use-card",
  "registryDependencies": [
    "button",
    "label",
    "~/registry/ui/card/index.ts"
  ],
  "files": [
    {
      "path": "example/use-card/index.ts",
      "content": "export { default as UseCard } from './UseCard.vue'\n",
      "type": "registry:example"
    },
    {
      "path": "example/use-card/UseCard.vue",
      "content": "<template>\n    <Card class=\"w-full max-w-sm\">\n        <CardHeader>\n            <CardTitle>Login to your account</CardTitle>\n            <CardDescription>\n                Enter your email below to login to your account\n            </CardDescription>\n            <CardAction>\n                <Button variant=\"link\">\n                    Sign Up\n                </Button>\n            </CardAction>\n        </CardHeader>\n        <CardContent>\n            <form>\n                <div class=\"grid w-full items-center gap-4\">\n                    <div class=\"flex flex-col space-y-1.5\">\n                        <Label for=\"email\">Email</Label>\n                        <Input id=\"email\" placeholder=\"m@example.com\" type=\"email\" />\n                    </div>\n                    <div class=\"flex flex-col space-y-1.5\">\n                        <div class=\"flex items-center\">\n                            <Label for=\"password\">Password</Label>\n                            <a class=\"ml-auto inline-block text-sm underline\" href=\"#\">\n                                Forgot your password?\n                            </a>\n                        </div>\n                        <Input id=\"password\" type=\"password\" />\n                    </div>\n                </div>\n            </form>\n        </CardContent>\n        <CardFooter class=\"flex flex-col gap-2\">\n            <Button class=\"w-full\">\n                Login\n            </Button>\n            <Button class=\"w-full\" variant=\"outline\">\n                Login with Google\n            </Button>\n        </CardFooter>\n    </Card>\n</template>\n\n<script lang=\"ts\" setup>\nimport { Button } from '@/components/ui/button'\n/**\n * TODO:由于不是nuxt项目，路径别名只能使用‘@’ ，不使用 '~'的话\n * 使用'@/registry/ui/card' 而不是 '~/components/ui/card'时，\n * 生成registry.json文件的时会被当成registryDependencies依赖的是官方组件，而不是 自定义的组件路径'~/components/ui/card'；\n * 所以需要添加路径别名'~'配置\n */\nimport { Card, CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '~/registry/ui/card/index.ts'\nimport { Label } from '@/components/ui/label'\n</script>\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}
